# =============================================================================
# MY-IA - Configuration minimale
# =============================================================================
# Copiez ce fichier vers .env et modifiez les valeurs.
#
# SEULES CES VARIABLES sont necessaires dans .env.
# TOUTE AUTRE CONFIGURATION est geree via:
# - Interface Admin > Systeme > Configuration
# - Table system_configs dans PostgreSQL
# =============================================================================


# =============================================================================
#                         IDENTITE (obligatoire)
# =============================================================================
# Prefixe pour nommer les containers et volumes Docker
# Format: minuscules et underscores uniquement (ex: my_ia, prod_app)
SANITIZED_PREFIX=my_ia


# =============================================================================
#                         POSTGRESQL (obligatoire)
# =============================================================================
# Super-utilisateur PostgreSQL (pour le container)
POSTGRES_USER=my_ia_postgres_admin
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_admin

# Utilisateur applicatif (cree par le script d'init)
APP_DB_USER=my_ia_db_user
APP_DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_app
APP_DB_NAME=my_ia_db

# URL de connexion (ne pas modifier sauf si PostgreSQL externe)
DATABASE_URL=postgresql+asyncpg://${APP_DB_USER}:${APP_DB_PASSWORD}@postgres:5432/${APP_DB_NAME}


# =============================================================================
#                         BOOTSTRAP (obligatoire)
# =============================================================================
# Active le chargement de la config depuis la BDD au demarrage
BOOTSTRAP_FROM_DB=true


# =============================================================================
#                    VARIABLES OPTIONNELLES (avec valeurs par defaut)
# =============================================================================
# Decommenter et modifier uniquement si necessaire

# --- Environnement ---
# DEPLOY_ENV=dev
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# --- Ports (defaut: 8080, 3000, 8081, 5432, 8000, 11434) ---
# APP_PORT=8080
# FRONTEND_PORT=3000
# ADMIN_PORT=8081
# POSTGRES_PORT=5432
# CHROMA_PORT=8000
# OLLAMA_PORT=11434

# --- Hosts reseau Docker (defaut: auto-detectes) ---
# OLLAMA_HOST=host.docker.internal
# CHROMA_HOST=chroma
# WHISPER_HOST=whisper
