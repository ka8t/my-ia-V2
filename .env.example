# =============================================================================
# MY-IA V2 — Configuration minimale
# =============================================================================
# Copier ce fichier vers .env et adapter les valeurs.
#
# Seules ces variables sont nécessaires dans .env.
# Toute autre configuration applicative est gérée via :
#   - Interface Admin > Système > Configuration
#   - Table system_configs dans PostgreSQL
# =============================================================================


# =============================================================================
#                         IDENTITÉ (obligatoire)
# =============================================================================
# Préfixe pour nommer les containers et volumes Docker
# Format : minuscules + underscores uniquement
# IMPORTANT : différent de my-ia v1 pour permettre cohabitation locale
SANITIZED_PREFIX=my_ia_v2


# =============================================================================
#                         POSTGRESQL (obligatoire)
# =============================================================================
POSTGRES_USER=my_ia_v2_postgres_admin
POSTGRES_PASSWORD=CHANGEZ_MOI_admin

# Utilisateur applicatif (créé par le script d'init)
APP_DB_USER=my_ia_v2_db_user
APP_DB_PASSWORD=CHANGEZ_MOI_app
APP_DB_NAME=my_ia_v2_db

# URL de connexion (ne pas modifier sauf si PostgreSQL externe)
DATABASE_URL=postgresql+asyncpg://${APP_DB_USER}:${APP_DB_PASSWORD}@postgres:5432/${APP_DB_NAME}


# =============================================================================
#                         BOOTSTRAP (obligatoire)
# =============================================================================
BOOTSTRAP_FROM_DB=true


# =============================================================================
#                         SESSIONS WEB (obligatoire)
# =============================================================================
# Clé secrète pour signer les cookies de session HTML (itsdangerous)
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=CHANGEZ_MOI_64_caracteres_aleatoires_minimum_pour_signer_les_cookies


# =============================================================================
#                    VARIABLES OPTIONNELLES (avec valeurs par défaut)
# =============================================================================

# --- Environnement ---
# DEPLOY_ENV=dev

# --- Ports (défauts décalés vs my-ia pour cohabitation locale) ---
# APP_PORT=8090
# POSTGRES_PORT=5442
# CHROMA_PORT=8010
# WHISPER_PORT=9011
# PGADMIN_PORT=5060

# --- Hosts réseau Docker ---
# OLLAMA_HOST=host.docker.internal
# OLLAMA_PORT=11434
# CHROMA_HOST=chroma
