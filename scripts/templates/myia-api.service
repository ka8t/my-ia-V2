[Unit]
Description=MY-IA API (FastAPI + Uvicorn)
After=network.target postgresql.service myia-chromadb.service
Wants=postgresql.service myia-chromadb.service

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
WorkingDirectory={{INSTALL_DIR}}/app
EnvironmentFile={{INSTALL_DIR}}/.env
ExecStart={{INSTALL_DIR}}/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port {{APP_PORT}} --workers 4 --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
