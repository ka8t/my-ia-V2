[Unit]
Description=MY-IA ChromaDB Vector Database
After=network.target

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
ExecStart={{INSTALL_DIR}}/venv/bin/chroma run --host 0.0.0.0 --port {{CHROMA_PORT}} --path {{INSTALL_DIR}}/data/chroma
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
